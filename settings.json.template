{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PROMPT=$(jq -r '.prompt'); REPO_ROOT=\"$(git rev-parse --show-toplevel)\"; agentkg ingest \"$PROMPT\" --role user --repo \"$REPO_ROOT\" 2>/dev/null || true",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "MSG=$(jq -r '.last_assistant_message // empty'); REPO_ROOT=\"$(git rev-parse --show-toplevel)\"; [ -n \"$MSG\" ] && agentkg ingest \"$MSG\" --role assistant --repo \"$REPO_ROOT\" --no-embed 2>/dev/null || true",
            "async": true
          },
          {
            "type": "command",
            "command": "REPO_ROOT=\"$(git rev-parse --show-toplevel)\"; agentkg snapshot --repo \"$REPO_ROOT\" --label \"session-end\" 2>/dev/null || true",
            "async": true
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(agentkg:*)",
      "Bash(agentkg-mcp:*)",
      "Bash(agentkg-ingest:*)",
      "Bash(agentkg-query:*)",
      "Bash(agentkg-assemble:*)",
      "Bash(agentkg-prune:*)",
      "Bash(agentkg-stats:*)",
      "Bash(agentkg-analyze:*)",
      "Bash(agentkg-sessions:*)",
      "Bash(agentkg-snapshot:*)",
      "Bash(agentkg-onboard:*)",
      "Bash(agentkg-profile:*)",
      "Bash(poetry install:*)",
      "Bash(poetry lock:*)",
      "Bash(poetry update:*)",
      "Bash(poetry show:*)",
      "Bash(poetry run:*)",
      "Bash(poetry add:*)",
      "Bash(poetry remove:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(ruff:*)",
      "Bash(ruff format:*)",
      "Bash(ruff check:*)",
      "Bash(mypy:*)",
      "Bash(pre-commit:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git push:*)",
      "Bash(git fetch:*)",
      "Bash(git restore:*)",
      "Bash(git tag:*)",
      "Bash(gh release:*)",
      "Bash(gh pr:*)"
    ]
  }
}
